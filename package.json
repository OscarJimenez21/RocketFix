{
  "name": "rocket-fix",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/fotos-livianas.mjs && vite",
    "build": "tsc -b && node scripts/fotos-livianas.mjs && vite build && node scripts/paginas-estaticas.mjs",
    "fotos": "node scripts/fotos-livianas.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "probar": "vitest run",
    "revisar": "npm run lint && npm run typecheck && npm run probar && npm run verificar",
    "enlaces": "node scripts/revisar-enlaces.mjs",
    "catalogo": "node scripts/extraer-catalogo.mjs",
    "auditoria": "node scripts/auditoria.mjs",
    "verificar": "node scripts/verificar-catalogo.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.7"
    }
  }
}
